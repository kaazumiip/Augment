PORT=3000
PYTHON_BACKEND_URL=http://127.0.0.1:5000
MAX_ACTIVE_GENERATIONS=1
# Server-only JSON from Firebase Admin credentials; set in Railway variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated browser origins allowed to call the API. Do not use * in production.
CORS_ORIGINS=https://app.example.com

# Keep these values only in the server environment. Never use dart-define for them.
BAKONG_TOKEN=replace-with-your-bakong-token
BAKONG_ACCOUNT_ID=merchant-name@bank
BAKONG_MERCHANT_NAME=Augment
BAKONG_MERCHANT_CITY=Phnom Penh
# Create a Bakong app/payment link in addition to the scannable QR.
BAKONG_DEEPLINK_ENABLED=false
# A public HTTPS URL for the Augment app icon. Bakong requires it before it
# issues a deeplink that returns to augment://payment/callback.
BAKONG_DEEPLINK_APP_ICON_URL=https://app.example.com/augment-icon.png
BAKONG_DEEPLINK_APP_NAME=Augment
# Set both only when your bank issued a merchant account profile.
BAKONG_MERCHANT_ID=
BAKONG_ACQUIRING_BANK=

# Marketplace checkout: server-only access used to calculate the cart total
# from published listings. Never put this service-role key in Flutter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Branded Firebase verification emails delivered by Resend. Keep the API key
# on the server only. The From address must use a domain verified in Resend.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL="Augment <verify@mail.example.com>"
# Long random server-only value used to hash verification codes. Generate at
# least 32 random bytes; changing it invalidates currently outstanding codes.
OTP_SECRET=replace-with-a-long-random-server-secret
